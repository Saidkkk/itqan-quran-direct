# =========================================================================
# إعدادات البيئة لتطبيق إتقان (Itqan Quran Platform)
# =========================================================================

PORT=3000

# -------------------------------------------------------------------------
# الخيار الأول (الموصى به - التفكيك الآمن لتجنب مشكلة الرمز @):
# -------------------------------------------------------------------------
DB_HOST=db-postgresql-fra1-xxxxx.b.db.ondigitalocean.com
DB_PORT=25060
DB_USER=doadmin
DB_PASSWORD=YourPasswordWith@Special#Chars
DB_NAME=defaultdb
DB_SSL=true
DB_SCHEMA=itqan

# -------------------------------------------------------------------------
# الخيار الثاني (رابط الاتصال المجمع URL):
# إذا استخدمت هذا الخيار وكانت كلمة المرور تحتوي @ استبدلها بـ %40
# -------------------------------------------------------------------------
# DATABASE_URL=postgresql://doadmin:YourPassword%40Special#Chars@db-postgresql-fra1-xxxxx.b.db.ondigitalocean.com:25060/defaultdb?sslmode=require&options=-csearch_path%3Ditqan,public
